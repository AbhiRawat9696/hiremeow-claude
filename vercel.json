{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/router?__path=:path*" }
  ],
  "functions": {
    "api/router.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron/ghosting", "schedule": "0 2 * * *" },
    { "path": "/api/cron/company-health", "schedule": "30 2 * * *" }
  ],
  "headers": [
    { "source": "/assets/(.*)\\.(js|css|json)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=(self)" }
    ] }
  ]
}
