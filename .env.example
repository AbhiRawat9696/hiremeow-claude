# Copy to .env for local development. Never commit .env.
# In Vercel: Project → Settings → Environment Variables.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this in browser code.
SUPABASE_SERVICE_KEY=

# OpenAI (live chat + Meow Lab AI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Stripe test mode (Meow Pool access)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MEOW_POOL_PRICE_THB=3000

# Public site URL used for Stripe redirects, e.g. https://hiremeow.vercel.app
APP_URL=

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET". Use a long random string.
CRON_SECRET=

# Ghosting Protection threshold (days)
GHOSTING_DAYS=5

# Layoff Radar news source: mock (default) or newsapi (needs NEWS_API_KEY)
NEWS_PROVIDER=mock
NEWS_API_KEY=
